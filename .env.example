# Copy to .env and replace placeholders. Never commit .env.
ENVIRONMENT=development
WEB_ORIGIN=http://localhost:3000
API_INTERNAL_URL=http://127.0.0.1:8000
DATABASE_URL=postgresql+asyncpg://fleetpilot_app:REPLACE_ME@127.0.0.1:54329/fleetpilot
MIGRATION_DATABASE_URL=postgresql+asyncpg://postgres:REPLACE_ME@127.0.0.1:54329/fleetpilot
SESSION_LIFETIME_SECONDS=28800
LOGIN_LIMIT=10
# Optional private local development evidence directory; default is .runtime/evidence-development.
# EVIDENCE_STORAGE_ROOT=C:/private/fleetpilot-evidence
STORAGE_BACKEND=local
RATE_LIMIT_BACKEND=memory
# Production requires STORAGE_BACKEND=s3 and RATE_LIMIT_BACKEND=postgres.
# S3_BUCKET=private-evidence
# S3_REGION=us-east-1
# S3_ENDPOINT=https://your-private-s3-endpoint
# S3_ACCESS_KEY / S3_SECRET_KEY: inject through secret store, or use SDK workload identity.
# S3_ALLOW_INSECURE_LOOPBACK=false (true only for explicit local S3 testing)
UPLOAD_LIMIT=30
EVIDENCE_ACCESS_LIMIT=120
MUTATION_LIMIT=120
# Explicit seed command reads this only; no automatic production seed.
DEMO_PASSWORD=REPLACE_WITH_SYNTHETIC_PASSWORD_16_CHARS
# Only needed for the optional Docker database alternative:
POSTGRES_PASSWORD=REPLACE_WITH_SEPARATE_RANDOM_OWNER_PASSWORD
APP_DATABASE_PASSWORD=REPLACE_WITH_SEPARATE_RANDOM_RUNTIME_PASSWORD
